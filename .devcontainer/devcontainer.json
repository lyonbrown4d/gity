{
  "name": "Gity Rust",
  "build": { "dockerfile": "Dockerfile" },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "forwardPorts": [8080, 2222, 5173],
  "customizations": {
    "vscode": {
      "settings": {
        "rust-analyzer.check.command": "clippy"
      },
      "extensions": ["rust-lang.rust-analyzer", "tamasfe.even-better-toml"]
    }
  }
}
