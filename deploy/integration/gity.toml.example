[database]
driver = "postgres"
dsn = "postgres://gity:gity-local-only@localhost:5433/gity"

[storage]
driver = "s3"
s3_bucket = "gity"
s3_endpoint = "http://localhost:9000"
s3_region = "us-east-1"
s3_access_key = "gitylocal"
s3_secret_key = "gity-storage-local-only"
s3_use_path_style = true

[observability]
# Prometheus in Docker reaches this listener through host.docker.internal.
# Metrics are for trusted integration networks; application auth is separate.
metrics_address = "0.0.0.0:9090"
otlp_endpoint = "http://localhost:4318/v1/traces"
