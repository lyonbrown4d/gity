# Local-only Alpine role images. These are not published release tags.
GITY_BASE=alpine
GITY_BUILDER_IMAGE=rust:1.99.1-alpine
GITY_RUNTIME_IMAGE=alpine:3.22
GITY_STANDALONE_IMAGE=gity:local-standalone-alpine
GITY_API_IMAGE=gity:local-api-alpine
GITY_GIT_IMAGE=gity:local-git-alpine
GITY_GIT_NODE_IMAGE=gity:local-git-node-alpine
GITY_GATEWAY_IMAGE=gity:local-gateway-alpine
GITY_REGISTRY_IMAGE=gity:local-registry-alpine
GITY_WORKER_IMAGE=gity:local-worker-alpine
GITY_RUNNER_IMAGE=gity:local-runner-alpine

# Generate independent values with `openssl rand -hex 32`; do not commit .env.
POSTGRES_PASSWORD=replace-with-random-32-byte-value
AUTHORITY_PEER_TOKEN=replace-with-random-32-byte-value
GIT_NODE_1_PEER_TOKEN=replace-with-random-32-byte-value
GIT_NODE_2_PEER_TOKEN=replace-with-random-32-byte-value
SEAWEED_ACCESS_KEY_ID=replace-with-random-32-byte-hex-value
SEAWEED_SECRET_KEY=replace-with-random-32-byte-hex-value
GITY_DOCKERHUB_USERNAME=
GITY_DOCKERHUB_TOKEN=
GITY_DISTRIBUTED_RUNNER_TOKEN=replace-with-a-project-scoped-runner-token
GITY_RUNNER_HOST_WORK_ROOT=/tmp/gity-runner-work
GITY_OUTBOUND_HTTP_PROXY=
GITY_OUTBOUND_HTTPS_PROXY=
GITY_OUTBOUND_NO_PROXY=localhost,127.0.0.1,::1,gity,api,git-server,git-node,git-node-2,gateway,registry,worker,runner,seaweed,postgres,docker

# Distributed global search; choose a unique password satisfying OpenSearch strength checks.
OPENSEARCH_INITIAL_ADMIN_PASSWORD=replace-with-a-strong-random-password
