GITY_APP__NAME=gity
GITY_APP__ENVIRONMENT=development
GITY_HTTP__ADDRESS=:8080
GITY_HTTP__BASE_URL=http://localhost:8080
GITY_DATABASE__DRIVER=sqlite
GITY_DATABASE__DSN=file:gity.db?_pragma=foreign_keys(1)
GITY_DATABASE__NODE_ID=1
GITY_GIT__REPO_ROOT=./data/repos
GITY_GIT__BIN=git
GITY_RUNNER_REPO_ROOT=./data/repos
GITY_STORAGE__DRIVER=local
GITY_STORAGE__ROOT=./data/storage
GITY_STORAGE__S3_BUCKET=
GITY_STORAGE__S3_REGION=us-east-1
GITY_STORAGE__S3_ENDPOINT=
GITY_STORAGE__S3_ACCESS_KEY=
GITY_STORAGE__S3_SECRET_KEY=
GITY_STORAGE__S3_USE_PATH_STYLE=true
GITY_STORAGE__S3_AUTO_CREATE_BUCKET=false
