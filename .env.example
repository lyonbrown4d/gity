GITY_APP_NAME=gity
GITY_APP_ENVIRONMENT=development
GITY_HTTP_ADDRESS=:8080
GITY_HTTP_BASE_URL=http://localhost:8080
GITY_DATABASE_DRIVER=sqlite
GITY_DATABASE_DSN=file:gity.db?_pragma=foreign_keys(1)
GITY_DATABASE_NODE_ID=1
GITY_GIT_REPO_ROOT=./data/repos
GITY_GIT_BIN=git
GITY_RUNNER_REPO_ROOT=./data/repos
GITY_STORAGE_DRIVER=local
GITY_STORAGE_ROOT=./data/storage
GITY_STORAGE_S3_BUCKET=
GITY_STORAGE_S3_REGION=us-east-1
GITY_STORAGE_S3_ENDPOINT=
GITY_STORAGE_S3_ACCESS_KEY=
GITY_STORAGE_S3_SECRET_KEY=
GITY_STORAGE_S3_USE_PATH_STYLE=true
GITY_STORAGE_S3_AUTO_CREATE_BUCKET=false
