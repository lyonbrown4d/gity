GITY_SERVER_PORT=8080
GITY_SERVER_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
GITY_AUTH_ADMIN_USERNAME=admin
GITY_AUTH_ADMIN_PASSWORD=admin
GITY_AUTH_SUPER_ADMINS=admin
GITY_DATABASE_URL=postgres://root:root@localhost:5433/gity
GITY_CACHE_CACHE_TYPE=REDIS
GITY_CACHE_URL=redis://localhost:6379
GITY_STORAGE_REPO_ROOT=./data/repos
GITY_GIT_ALLOW_ANONYMOUS_READ=false
GITY_ISSUE_ATTACHMENTS_PROVIDER=s3
GITY_ISSUE_ATTACHMENTS_MAX_FILE_SIZE=10485760
GITY_ISSUE_ATTACHMENTS_S3_ENDPOINT=http://127.0.0.1:9000
GITY_ISSUE_ATTACHMENTS_S3_REGION=us-east-1
GITY_ISSUE_ATTACHMENTS_S3_BUCKET=gity-issues
GITY_ISSUE_ATTACHMENTS_S3_ACCESS_KEY=minioadmin
GITY_ISSUE_ATTACHMENTS_S3_SECRET_KEY=minioadmin
GITY_ISSUE_ATTACHMENTS_S3_PUBLIC_BASE_URL=http://127.0.0.1:9000/gity-issues
GITY_ISSUE_ATTACHMENTS_S3_FORCE_PATH_STYLE=true
