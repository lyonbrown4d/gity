# Cargo server configuration: defaults < config/gity.toml < --config < GITY_*.
GITY_HTTP__ADDRESS=0.0.0.0:8080
GITY_HTTP__BASE_URL=http://localhost:8080
GITY_DATABASE__DRIVER=sqlite
GITY_DATABASE__DSN=sqlite://data/gity.db?mode=rwc
GITY_DATABASE__NODE_ID=1
GITY_GIT__REPO_ROOT=data/repos
GITY_GIT__BIN=git
# Independent SSH listener; public keys are project deploy keys, SSH username is git.
GITY_SSH__ENABLED=false
GITY_SSH__ADDRESS=0.0.0.0:2222
GITY_SSH__HOST_KEY=data/ssh_host_ed25519
GITY_SSH__MAX_CONNECTIONS=64
GITY_SSH__OPERATION_TIMEOUT_SECONDS=900
GITY_STORAGE__DRIVER=local
GITY_STORAGE__ROOT=data/storage
GITY_WEB__ROOT=dist/web
GITY_SEARCH__INDEX_ENABLED=true
GITY_SEARCH__INDEX_ROOT=data/search-index
GITY_SEARCH__REFRESH_INTERVAL_SECONDS=300
GITY_SEARCH__MAX_FILES_PER_PROJECT=5000
GITY_SEARCH__MAX_FILE_SIZE_BYTES=524288
GITY_OBSERVABILITY__SERVICE_NAME=gity-server
GITY_OBSERVABILITY__LOG_FORMAT=json
GITY_OBSERVABILITY__LOG_LEVEL=gity=info,tower_http=info
GITY_OBSERVABILITY__METRICS_ENABLED=true
GITY_OBSERVABILITY__METRICS_ADDRESS=127.0.0.1:9090
# Enable when an OTLP HTTP collector is available.
GITY_OBSERVABILITY__OTLP_ENDPOINT=
# Runner registration yields a project-scoped token. Keep it out of version control.
GITY_RUNNER__SERVER_URL=http://localhost:8080
GITY_RUNNER__EXECUTOR=container
GITY_RUNNER__WORK_ROOT=data/runner
