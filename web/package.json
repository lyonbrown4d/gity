{
  "name": "gity-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "pnpm typecheck && vite build --config vite.config.ts",
    "build:ci": "pnpm typecheck && vite build --config vite.config.ts --mode production",
    "build:debug": "pnpm typecheck && vite build --config vite.config.ts --mode development --sourcemap",
    "preview": "vite preview --config vite.config.ts",
    "test:e2e": "pnpm typecheck:e2e && playwright test",
    "test:e2e:blackbox": "pnpm typecheck:e2e && playwright test -c playwright.blackbox.config.ts",
    "e2e": "pnpm test:e2e",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "gen:api": "orval",
    "test": "vitest run"
  },
  "dependencies": {
    "@milkdown/core": "^7.23.0",
    "@milkdown/plugin-listener": "^7.23.0",
    "@milkdown/preset-commonmark": "^7.23.0",
    "@milkdown/preset-gfm": "^7.23.0",
    "@milkdown/react": "^7.23.0",
    "@milkdown/theme-nord": "^7.23.0",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@refinedev/core": "^5.0.12",
    "@tanstack/react-query": "^5.105.1",
    "axios": "^1.21.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dayjs": "^1.11.23",
    "dompurify": "^3.4.17",
    "lucide-react": "^1.66.0",
    "marked": "^18.1.2",
    "motion": "^14.9.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "rxjs": "^7.8.2",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "orval": "^8.46.0",
    "postcss": "^8.5.32",
    "sass": "^1.107.1",
    "sass-embedded": "^1.107.1",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-compression2": "^2.5.4",
    "@testing-library/react": "^16.3.3",
    "jsdom": "^30.1.3",
    "vitest": "^5.0.5"
  }
}
