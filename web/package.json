{
  "name": "gity-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "pnpm typecheck && vite build --config vite.config.ts",
    "build:ci": "pnpm typecheck && vite build --config vite.config.ts --mode production",
    "build:debug": "pnpm typecheck && vite build --config vite.config.ts --mode development --sourcemap",
    "preview": "vite preview --config vite.config.ts",
    "test:e2e": "pnpm typecheck:e2e && playwright test",
    "test:e2e:blackbox": "pnpm typecheck:e2e && playwright test -c playwright.blackbox.config.ts",
    "e2e": "pnpm test:e2e",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json"
  },
  "dependencies": {
    "@milkdown/core": "^7.22.2",
    "@milkdown/plugin-listener": "^7.22.2",
    "@milkdown/preset-commonmark": "^7.22.2",
    "@milkdown/preset-gfm": "^7.22.2",
    "@milkdown/react": "^7.22.2",
    "@milkdown/theme-nord": "^7.22.2",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-avatar": "^1.2.7",
    "@radix-ui/react-checkbox": "^1.3.12",
    "@radix-ui/react-collapsible": "^1.1.21",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-label": "^2.1.16",
    "@radix-ui/react-scroll-area": "^1.3.0",
    "@radix-ui/react-select": "^2.3.8",
    "@radix-ui/react-separator": "^1.1.16",
    "@radix-ui/react-slot": "^1.4.0",
    "@radix-ui/react-tabs": "^1.1.22",
    "@radix-ui/react-tooltip": "^1.3.0",
    "@refinedev/core": "^5.0.12",
    "@tanstack/react-query": "^5.104.1",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dayjs": "^1.11.23",
    "dompurify": "^3.4.16",
    "lucide-react": "^1.53.0",
    "marked": "^18.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-compression2": "^2.5.3"
  }
}
