GITY_IMAGE_TAG=v0.1.0-beta.1
GITY_HTTP_PORT=8080

GITY_APP__NAME=gity
GITY_APP__ENVIRONMENT=production
GITY_HTTP__ADDRESS=:8080
GITY_HTTP__BASE_URL=https://gity.example.com

GITY_MYSQL_ROOT_PASSWORD=change-me-root
GITY_MYSQL_PASSWORD=change-me-gity
GITY_DATABASE__DRIVER=mysql
GITY_DATABASE__NODE_ID=1

GITY_GIT__REPO_ROOT=/var/lib/gity/repos
GITY_GIT__BIN=git
GITY_STORAGE__DRIVER=s3
GITY_STORAGE__ROOT=/var/lib/gity/storage
GITY_STORAGE__S3_BUCKET=gity
GITY_STORAGE__S3_REGION=us-east-1
GITY_STORAGE__S3_ENDPOINT=http://minio:9000
GITY_STORAGE__S3_ACCESS_KEY=gity
GITY_STORAGE__S3_SECRET_KEY=change-me-minio
GITY_STORAGE__S3_USE_PATH_STYLE=true
GITY_STORAGE__S3_AUTO_CREATE_BUCKET=true

GITY_WORKER__ENABLED=true
GITY_WORKER__POLL_INTERVAL_MILLIS=1000
GITY_WORKER__LEASE_SECONDS=60
GITY_WORKER__MAX_JOBS_PER_TICK=4

GITY_SEARCH__INDEX_ENABLED=true
GITY_SEARCH__INDEX_ROOT=/var/lib/gity/search-index
GITY_SEARCH__REFRESH_INTERVAL_SECONDS=300
GITY_SEARCH__MAX_FILES_PER_PROJECT=5000
GITY_SEARCH__MAX_FILE_SIZE_BYTES=524288
