# Copy to .env.production; supply strong, URL-safe values before starting Compose.
GITY_BASE_URL=https://gity.example.com
GITY_HTTP_PORT=8080
GITY_DB_PASSWORD=
GITY_S3_ACCESS_KEY=
GITY_S3_SECRET_KEY=
GITY_SERVER_IMAGE=gity-server:local
GITY_RUNNER_IMAGE=gity-runner:local
GITY_OTLP_ENDPOINT=
# Optional runner profile; project-scoped token, Docker socket group ID and
# absolute host work path. Create/chown the path to 10001:10001 first.
GITY_RUNNER_TOKEN=
GITY_DOCKER_GID=999
GITY_RUNNER_WORK_ROOT=/srv/gity-runner

# SSH is independent of HTTP. Persist the generated host key in app_data.
GITY_SSH_ENABLED=false
GITY_SSH_BIND=127.0.0.1
GITY_SSH_PORT=2222
