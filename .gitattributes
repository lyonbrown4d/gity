* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.tgz binary
# Preserve upstream documentation bundles, including template-string whitespace.
docs/shared/vendor/*.js -whitespace

# Preserve pinned third-party template bytes and their provenance checksums.
crates/gity-projects/templates/*.txt -text -whitespace
crates/gity-projects/templates/gitignores/* -text -whitespace
